# Main dev container environment
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://vela:vela_password@localhost:5432/vela?schema=public
NEXT_TELEMETRY_DISABLED=1

# Better Auth configuration
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production
BETTER_AUTH_URL=http://localhost:3000
# Optional for client-side override; leave unset to use same-origin
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed to call Better Auth endpoints
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-only Ollama origin (an optional trailing /api is also accepted).
# In a dev container, use the host/LAN address when Ollama runs on the host PC.
OLLAMA_BASE_URL=http://localhost:11434
