# Main dev container environment
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://vela:vela_password@localhost:5432/vela?schema=public
NEXT_TELEMETRY_DISABLED=1

# Better Auth configuration (required: a non-placeholder secret of at least 32 characters)
BETTER_AUTH_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:3000
# Optional for client-side override; leave unset to use same-origin
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed to call Better Auth endpoints
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-only Ollama origin (an optional trailing /api is also accepted).
# In a dev container, use the host/LAN address when Ollama runs on the host PC.
OLLAMA_BASE_URL=http://localhost:11434

# Optional exact signup email allowlist. Local default: existing test-email domain.
# Public mode defaults to closed registration. Provision the personal user locally.
# VELA_SIGNUP_EMAILS=you@example.com
# Public commands reuse these database/auth settings and force the HTTPS origin.
# See docs/DAILY_USE_DEPLOYMENT.md; do not tunnel yarn dev.

# Home Assistant: exact trusted origins (no paths), shared by app and sync worker.
HOME_ASSISTANT_ALLOWED_ORIGINS=
# Dedicated stable secret: generate privately with `openssl rand -hex 32`.
# Back up separately; changing it requires re-entering saved connection tokens.
INTEGRATION_ENCRYPTION_KEY=
# Private image storage. Absolute path; mount persistent storage here in production.
# Development defaults to .local/attachments in the workspace bind mount.
# VELA_ATTACHMENT_STORAGE_DIR=/var/lib/vela/attachments
