// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Vela Dev Container",
	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",
	"workspaceFolder": "/workspaces/vela",
	"shutdownAction": "stopCompose",
	"remoteUser": "node",
	"initializeCommand": ["bash", ".devcontainer/scripts/prepare-adb-directory.sh"],
	"postCreateCommand": "bash .devcontainer/scripts/android-cache-permissions.sh && yarn install",
	"postStartCommand": "python3 .devcontainer/scripts/container-adb-relay.py --start && docker compose -f .devcontainer/docker-compose.inner.yml up -d --build",
	"forwardPorts": [3000, 5050],
	"customizations": {
		"vscode": {
			"extensions": []
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
			"dockerDashComposeVersion": "none",
			"moby": false
		}
	}
}
