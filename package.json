{
  "name": "mantine-next-template",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "companion:prune": "tsx --conditions=react-server scripts/companion-prune.ts",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "home-assistant:sync": "tsx --conditions=react-server scripts/home-assistant-worker.ts",
    "tasks:index": "tsx --conditions=react-server scripts/task-index-worker.ts",
    "nutrition:index": "tsx --conditions=react-server scripts/nutrition-index-worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run oxlint && npm run stylelint",
    "oxlint": "oxlint -c oxlint.config.mjs .",
    "stylelint": "stylelint '**/*.css' --cache",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"**/*.{ts,tsx,css}\"",
    "test": "npx next typegen && npm run format:test && npm run lint && npm run typecheck && npm run jest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "public:build": "node scripts/public-server.mjs build",
    "public:start": "node scripts/public-server.mjs start",
    "db:backup": "node scripts/database-backup.mjs",
    "health:import:withings": "tsx --conditions=react-server scripts/health-import-withings.ts",
    "health:import:samsung": "tsx --conditions=react-server scripts/health-import-samsung.ts"
