// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id
  name                      String
  email                     String
  emailVerified             Boolean                    @default(false)
  image                     String?
  timezone                  String                     @default("Europe/Amsterdam") @db.VarChar(64)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deviceCredentials         DeviceCredential[]
  devicePairings            DevicePairing[]
  sessions                  Session[]
  accounts                  Account[]
  themes                    Theme[]
  locations                 Location[]
  tasks                     Task[]
  taskReviews               TaskReview[]
  savedViews                SavedView[]
  taskDependencies          TaskDependency[]
  taskOccurrences           TaskOccurrence[]
  planningProposals         PlanningProposal[]
  dailyPlans                DailyPlan[]
  dailyBlocks               DailyBlock[]
  dayOverrides              DayOverride[]
  calendarEvents            CalendarEvent[]
  checkins                  Checkin[]
  automationRuns            AutomationRun[]
  availabilityWindows       AvailabilityWindow[]
  plannerGenerationSettings PlannerGenerationSettings?
  plannerConversations      PlannerConversation[]
  aiConversations           AiConversation[]
  aiModelSettings           UserAiModelSetting[]
  products                  Product[]
  nutritionLogEntries       NutritionLogEntry[]
  homeAssistantConnection   HomeAssistantConnection?
  healthMetrics             HealthMetric[]
  healthGoal                HealthGoal?
  nutritionGoals            NutritionGoals?
  taskIndexJob              TaskIndexJob?
  nutritionIndexJob         NutritionProductIndexJob?
  nutritionDrafts           NutritionMealDraft[]
  nutritionMealCopies       NutritionMealCopy[]
  discoverItems             DiscoverItem[]

  @@unique([email])
  @@map("user")
}

enum DiscoverStatus {
  WANT_TO_EXPLORE
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  DROPPED
}

model DiscoverItem {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String         @db.VarChar(240)
  contentType String         @default("Other") @db.VarChar(80)
  status      DiscoverStatus @default(WANT_TO_EXPLORE)
  description String?
  url         String?        @db.VarChar(2048)
  // Hash of the normalized URL, independent of manually editable title/details.
  urlKey      String?        @db.Char(64)
  imageUrl    String?        @db.VarChar(2048)
  // Latest retrieved web metadata; never written from editable item input.
  sourceMetadata Json?       @db.JsonB
  tags        String[]       @default([])
  priority    Int?
  notes       String?
  rating      Int?
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, urlKey])
  @@index([userId, createdAt])
  @@index([userId, contentType, status])
  @@map("discover_items")
}

enum AiMessageRole {
  user
  assistant
}

model UserAiModelSetting {
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String @db.VarChar(64)
  value  Json @db.JsonB

  @@id([userId, key])
  @@map("user_ai_model_settings")
}

enum AiMessageStatus {
  COMPLETED
  GENERATING
  INTERRUPTED
  FAILED
}

model AiConversation {
  scope                String      @default("ai-dev") @db.VarChar(32)
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String      @default("New conversation") @db.VarChar(240)
  provider             String      @db.VarChar(64)
  modelId              String      @db.VarChar(200)
  inheritsModel        Boolean     @default(true)
  activeGenerationId   String?     @db.Uuid
  generationStartedAt  DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  messages             AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  conversationId String          @db.Uuid
  conversation   AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  id             String          @db.VarChar(128)
  role           AiMessageRole
  parts          Json            @db.JsonB
  position       Int
  status         AiMessageStatus @default(COMPLETED)
  replyToId      String?         @db.VarChar(128)
  provider       String?         @db.VarChar(64)
  modelId        String?         @db.VarChar(200)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@id([conversationId, id])
  @@unique([conversationId, position])
  @@unique([conversationId, replyToId])
  @@map("ai_messages")
}

model AvailabilityWindow {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday     Int
  startMinute Int
  endMinute   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weekday, startMinute, endMinute])
  @@index([userId, weekday, isActive])
  @@map("availability_windows")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum TaskStatus {
  BACKLOG
  PAUSED
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum PlanningCategory {
  WORK
  LIFE
  LEISURE
  REST
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
}

enum OccurrenceStatus {
  PENDING
  SCHEDULED
  DONE
  SKIPPED
  CANCELED
}

enum OccurrenceOrigin {
  MANUAL
  RECURRENCE
  IMPORT
}

enum DailyPlanStatus {
  DRAFT
  ACTIVE
  FINALIZED
  ARCHIVED
}

enum PlanGenerationSource {
  MANUAL
  MORNING_RUN
  REPLAN
  AUTOMATION
}

enum BlockStatus {
  PLANNED
  IN_PROGRESS
  DONE
  SKIPPED
  CANCELED
}

enum BlockSource {
  MANUAL
  PLANNER
  REPLAN
  AUTOMATION
}

enum CategorySlotSource {
  MANUAL
  PLANNER
}

enum DayWorkMode {
  NORMAL
  WFH
  PTO
  NO_WORK
  CUSTOM
}

enum CalendarEventSource {
  HA
  GOOGLE
  ICS
  MANUAL
}

enum AutomationRunType {
  PLAN_INIT
  MORNING_RUN
  REPLAN
  CALENDAR_SYNC
  HA_PROJECTION
}

enum AutomationRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

model Theme {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(120)
  brief     String?
  content   Json?    @db.JsonB
  color     String?  @db.VarChar(32)
  category  PlanningCategory @default(WORK)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@unique([userId, name])
  @@index([userId])
  @@map("themes")
}

model PlannerGenerationSettings {
  mealPreferences    Json?    @db.JsonB
  mealVersion        Int      @default(0)
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSessionMinutes Int      @default(90)
  shortBreakMinutes  Int      @default(15)
  leisureMinutes     Int      @default(60)
  shortLeisureBlockMinutes Int @default(30)
  maxLeisureBlockMinutes   Int @default(90)
  fillExistingPlan   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("planner_generation_settings")
}

model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String   @db.VarChar(64)
  name      String   @db.VarChar(120)
  config    Json     @db.JsonB
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scope])
  @@map("saved_views")
}

model Location {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(120)
  brief        String?
  content      Json?         @db.JsonB
  timezone     String?       @db.VarChar(64)
  latitude     Decimal?      @db.Decimal(9, 6)
  longitude    Decimal?      @db.Decimal(9, 6)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        Task[]
  dayOverrides DayOverride[]

  @@unique([userId, name])
  @@index([userId])
  @@map("locations")
}

model Task {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId          String?    @db.Uuid
  theme            Theme?     @relation(fields: [themeId], references: [id], onDelete: SetNull)
  category         PlanningCategory?
  locationId       String?    @db.Uuid
  location         Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  title            String     @db.VarChar(240)
  brief            String?
  content          Json?      @db.JsonB
  priority         Int        @default(3)
  size             Int        @default(3)
  status           TaskStatus @default(BACKLOG)
  firstStep        String?
  dueDate          DateTime?  @db.Date
  tags             String[]   @default([])
  earliestStartAt  DateTime?
  estimatedMinutes Int?
  leadTimeDays     Int?
  isRecurring      Boolean    @default(false)
  recurrenceRule   String?
  recurrenceAnchorDate DateTime? @db.Date
  recurrenceTz     String?    @db.VarChar(64)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  archivedAt       DateTime?
  embedding        TaskEmbedding?
  reviews          TaskReview[]

  dependenciesBlocking  TaskDependency[] @relation("TaskBlocked")
  dependenciesDependsOn TaskDependency[] @relation("TaskDependsOn")
  occurrences           TaskOccurrence[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([themeId])
  @@index([locationId])
  @@map("tasks")
}

model EmbeddingCollectionConfig {
  key            String    @id @db.VarChar(120)
  configuration  Json?     @db.JsonB
  revision       Int       @default(0)
  leaseId        String?   @db.Uuid
  leaseExpiresAt DateTime?
  lastError      String?   @db.VarChar(500)
  updatedAt      DateTime  @updatedAt

  @@map("embedding_collection_configs")
}

model TaskEmbedding {
  taskId          String                @id @db.Uuid
  task            Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  embedding       Unsupported("vector")
  sourceHash      String                @db.Char(64)
  sourceUpdatedAt DateTime
  indexedAt       DateTime              @default(now())

  @@map("task_embeddings")
}

enum ProductCalculationMode {
  DIRECT
  CALCULATED
}

enum NutritionReferenceUnit {
  G
  ML
  SERVING
}

enum NutritionQuantityUnit {
  G
  KG
  ML
  L
  SERVING
}

enum ProductSourceType {
  MANUAL
  DATASET
  AI_ESTIMATE
  EXTERNAL_API
}

enum ProductVerificationStatus {
  UNVERIFIED
  VERIFIED
  ESTIMATED
}

model Product {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String                    @db.VarChar(240)
  brand                  String?                   @db.VarChar(240)
  description            String?
  aliases                String[]                  @default([])
  normalizedName         String                    @db.VarChar(240)
  normalizedAliases      String[]                  @default([])
  searchText             String
  searchUpdatedAt        DateTime                  @default(now())
  calculationMode        ProductCalculationMode    @default(DIRECT)
  referenceQuantity      Decimal                   @db.Decimal(20, 8)
  referenceUnit          NutritionReferenceUnit
  referenceLabel         String?                   @db.VarChar(80)
  calories               Decimal?                  @db.Decimal(20, 8)
  protein                Decimal?                  @db.Decimal(20, 8)
  carbohydrates          Decimal?                  @db.Decimal(20, 8)
  fat                    Decimal?                  @db.Decimal(20, 8)
  fiber                  Decimal?                  @db.Decimal(20, 8)
  servingSizeQuantity    Decimal?                  @db.Decimal(20, 8)
  servingSizeUnit        NutritionReferenceUnit?
  servingSizeIsEstimated Boolean                   @default(false)
  densityGramsPerMl      Decimal?                  @db.Decimal(20, 8)
  densityIsEstimated     Boolean                   @default(false)
  yieldQuantity          Decimal?                  @db.Decimal(20, 8)
  yieldUnit              NutritionReferenceUnit?
  sourceType             ProductSourceType         @default(MANUAL)
  sourceName             String?                   @db.VarChar(240)
  sourceRecordId         String?                   @db.VarChar(240)
  sourceVersion          String?                   @db.VarChar(120)
  sourceSnapshot         Json?                     @db.JsonB
  importedAt             DateTime?
  verificationStatus     ProductVerificationStatus @default(UNVERIFIED)
  userModifiedAt         DateTime?
  archivedAt             DateTime?
  version                Int                       @default(1)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  servings               ProductServing[]
  components             ProductComponent[]        @relation("ProductParent")
  usedIn                 ProductComponent[]        @relation("ProductChild")
  logEntries             NutritionLogEntry[]
  embedding              ProductEmbedding?

  @@unique([userId, id])
  @@unique([userId, sourceType, sourceName, sourceRecordId])
  @@index([userId, archivedAt, normalizedName])
  @@map("products")
}

model ProductEmbedding {
  productId       String                @id @db.Uuid
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  embedding       Unsupported("vector")
  sourceHash      String                @db.Char(64)
  sourceUpdatedAt DateTime
  indexedAt       DateTime              @default(now())

  @@map("product_embeddings")
}

model NutritionProductIndexJob {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision          Int       @default(1)
  completedRevision Int       @default(0)
  attempts          Int       @default(0)
  runAfter          DateTime  @default(now())
  leaseId           String?   @db.Uuid
  leaseExpiresAt    DateTime?
  lastError         String?   @db.VarChar(500)
  updatedAt         DateTime  @updatedAt

  @@index([runAfter])
  @@map("nutrition_product_index_jobs")
}

model ProductServing {
  id             String                 @id @default(uuid()) @db.Uuid
  productId      String                 @db.Uuid
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String                 @db.VarChar(80)
  normalizedName String                 @db.VarChar(80)
  aliases        String[]               @default([])
  quantity       Decimal                @db.Decimal(20, 8)
  canonicalUnit  NutritionReferenceUnit
  isDefault      Boolean                @default(false)
  isEstimated    Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  components     ProductComponent[]

  @@unique([productId, id])
  @@unique([productId, normalizedName])
  @@map("product_servings")
}

model ProductComponent {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String
  parentProductId String                @db.Uuid
  childProductId  String                @db.Uuid
  parentProduct   Product               @relation("ProductParent", fields: [userId, parentProductId], references: [userId, id], onDelete: Cascade)
  childProduct    Product               @relation("ProductChild", fields: [userId, childProductId], references: [userId, id], onDelete: Restrict)
  quantity        Decimal               @db.Decimal(20, 8)
  unit            NutritionQuantityUnit
  servingId       String?               @db.Uuid
  serving         ProductServing?       @relation(fields: [childProductId, servingId], references: [productId, id], onDelete: Restrict, onUpdate: NoAction)
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([parentProductId, sortOrder])
  @@index([childProductId])
  @@index([childProductId, servingId])
  @@map("product_components")
}

enum NutritionMealCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

enum NutritionDraftStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

enum NutritionDraftTurnStatus {
  GENERATING
  COMPLETED
  FAILED
}

model NutritionMealDraft {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String                @default("Meal draft") @db.VarChar(120)
  logDate             DateTime              @db.Date
  mealCategory        NutritionMealCategory
  provider            String                @db.VarChar(40)
  modelId             String                @db.VarChar(200)
  inheritsModel       Boolean               @default(true)
  status              NutritionDraftStatus  @default(DRAFT)
  revision            Int                   @default(1)
  items               Json                  @default("[]") @db.JsonB
  questions           String[]              @default([])
  generationId        String?               @db.Uuid
  generationExpiresAt DateTime?
  confirmedEntryIds   String[]              @default([]) @db.Uuid
  confirmedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  turns               NutritionDraftTurn[]

  @@index([userId, status, updatedAt])
  @@map("nutrition_meal_drafts")
}

model NutritionDraftTurn {
  id                String                   @id @db.Uuid
  draftId           String                   @db.Uuid
  draft             NutritionMealDraft       @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userText          String
  assistantText     String?
  diagnostics       Json?                    @db.JsonB
  status            NutritionDraftTurnStatus @default(GENERATING)
  requestedRevision Int
  error             String?                  @db.VarChar(500)
  provider          String?                  @db.VarChar(64)
  modelId           String?                  @db.VarChar(200)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([draftId, createdAt])
  @@map("nutrition_draft_turns")
}

model NutritionLogEntry {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String?                @db.Uuid
  product             Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  logDate             DateTime               @db.Date
  mealCategory        NutritionMealCategory
  productNameSnapshot String                 @db.VarChar(240)
  quantity            Decimal                @db.Decimal(20, 8)
  unit                NutritionQuantityUnit
  servingId           String?                @db.Uuid
  unitLabelSnapshot   String                 @db.VarChar(80)
  resolvedQuantity    Decimal                @db.Decimal(20, 8)
  referenceUnit       NutritionReferenceUnit
  calories            Decimal                @db.Decimal(20, 8)
  protein             Decimal                @db.Decimal(20, 8)
  carbohydrates       Decimal                @db.Decimal(20, 8)
  fat                 Decimal                @db.Decimal(20, 8)
  fiber               Decimal?               @db.Decimal(20, 8)
  estimated           Boolean                @default(false)
  referenceSnapshot   Json                   @db.JsonB
  requestId           String                 @db.Uuid
  requestHash         String                 @db.Char(64)
  version             Int                    @default(1)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([userId, requestId])
  @@index([userId, logDate, mealCategory])
  @@index([userId, productId, logDate])
  @@index([productId])
  @@map("nutrition_log_entries")
}

model NutritionMealCopy {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String   @db.Uuid
  requestHash String   @db.Char(64)
  entryIds    String[] @db.Uuid
  targetDate  DateTime @db.Date
  createdAt   DateTime @default(now())

  @@id([userId, requestId])
  @@map("nutrition_meal_copies")
}

model NutritionGoals {
  semantics     Json     @default("{}")
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories      Decimal? @db.Decimal(20, 8)
  protein       Decimal? @db.Decimal(20, 8)
  carbohydrates Decimal? @db.Decimal(20, 8)
  fat           Decimal? @db.Decimal(20, 8)
  fiber         Decimal? @db.Decimal(20, 8)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("nutrition_goals")
}

model TaskDependency {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockedTaskId   String         @db.Uuid
  blockedTask     Task           @relation("TaskBlocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String         @db.Uuid
  dependsOnTask   Task           @relation("TaskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  dependencyType  DependencyType @default(FINISH_TO_START)
  isHardBlock     Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@unique([blockedTaskId, dependsOnTaskId])
  @@index([userId])
  @@index([blockedTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskOccurrence {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId               String           @db.Uuid
  task                 Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrenceDate       DateTime         @db.Date
  dueAt                DateTime?
  status               OccurrenceStatus @default(PENDING)
  origin               OccurrenceOrigin @default(RECURRENCE)
  generatedRuleVersion Int              @default(1)
  completedAt          DateTime?
  skippedAt            DateTime?
  canceledAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  dailyBlocks          DailyBlock[]
  checkins             Checkin[]

  @@unique([taskId, occurrenceDate])
  @@index([userId])
  @@index([taskId])
  @@index([userId, occurrenceDate])
  @@index([userId, status])
  @@map("task_occurrences")
}

model DailyPlan {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDate        DateTime             @db.Date
  timezone        String               @default("UTC") @db.VarChar(64)
  status          DailyPlanStatus      @default(DRAFT)
  version         Int                  @default(1)
  isCurrent       Boolean              @default(true)
  generatedBy     PlanGenerationSource @default(MANUAL)
  explanationJson Json?                @db.JsonB
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  finalizedAt     DateTime?
  dailyBlocks     DailyBlock[]
  categorySlots   DailyPlanCategorySlot[]
  checkins        Checkin[]

  @@unique([userId, planDate, version])
  @@index([userId])
  @@index([userId, planDate])
  @@index([userId, planDate, isCurrent])
  @@map("daily_plans")
}

model DailyBlock {
  mealKind         String?         @db.VarChar(16)
  id               String          @id @default(uuid()) @db.Uuid
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String          @db.Uuid
  plan             DailyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  taskOccurrenceId String?         @db.Uuid
  taskOccurrence   TaskOccurrence? @relation(fields: [taskOccurrenceId], references: [id], onDelete: SetNull)
  calendarEventId  String?         @db.Uuid
  calendarEvent    CalendarEvent?  @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  category         PlanningCategory?
  title            String          @db.VarChar(240)
  brief            String?
  content          Json?           @db.JsonB
  startsAt         DateTime
  endsAt           DateTime
  durationMinutes  Int
  status           BlockStatus     @default(PLANNED)
  source           BlockSource     @default(MANUAL)
  position         Int?
  isFixed          Boolean         @default(false)
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  checkins         Checkin[]

  @@index([userId])
  @@index([planId])
  @@index([taskOccurrenceId])
  @@index([calendarEventId])
  @@index([userId, startsAt])
  @@unique([planId, mealKind])
  @@index([planId, position])
  @@index([planId, startsAt])
  @@map("daily_blocks")
}

model DailyPlanCategorySlot {
  id         String             @id @default(uuid()) @db.Uuid
  planId     String             @db.Uuid
  plan       DailyPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  category   PlanningCategory
  startsAt   DateTime
  endsAt     DateTime
  source     CategorySlotSource @default(MANUAL)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([planId, startsAt])
  @@map("daily_plan_category_slots")
}

model DayOverride {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrideDate        DateTime                 @db.Date
  workMode            DayWorkMode              @default(CUSTOM)
  startTime           DateTime?                @db.Time(6)
  endTime             DateTime?                @db.Time(6)
  capacityMinutes     Int?
  locationId          String?                  @db.Uuid
  location            Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  brief               String?
  content             Json?                    @db.JsonB
  source              String                   @default("manual") @db.VarChar(64)
  availabilityWindows DateAvailabilityWindow[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([userId, overrideDate])
  @@index([userId])
  @@index([locationId])
  @@map("day_overrides")
}

model DateAvailabilityWindow {
  id            String      @id @default(uuid()) @db.Uuid
  dayOverrideId String      @db.Uuid
  dayOverride   DayOverride @relation(fields: [dayOverrideId], references: [id], onDelete: Cascade)
  startMinute   Int
  endMinute     Int
  createdAt     DateTime    @default(now())

  @@unique([dayOverrideId, startMinute, endMinute])
  @@index([dayOverrideId])
  @@map("date_availability_windows")
}

model CalendarEvent {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalCalendarId String              @db.VarChar(200)
  externalEventId    String              @db.VarChar(200)
  title              String              @db.VarChar(240)
  brief              String?
  content            Json?               @db.JsonB
  startsAt           DateTime
  endsAt             DateTime
  isAllDay           Boolean             @default(false)
  isBusy             Boolean             @default(true)
  source             CalendarEventSource @default(MANUAL)
  ownershipMarker    String?             @db.VarChar(120)
  rawPayload         Json?               @db.JsonB
  syncedAt           DateTime?
  dailyBlocks        DailyBlock[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, externalCalendarId, externalEventId])
  @@index([userId])
  @@index([userId, startsAt])
  @@index([userId, endsAt])
  @@map("calendar_events")
}

model Checkin {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String?         @db.Uuid
  plan              DailyPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  taskOccurrenceId  String?         @db.Uuid
  taskOccurrence    TaskOccurrence? @relation(fields: [taskOccurrenceId], references: [id], onDelete: SetNull)
  blockId           String?         @db.Uuid
  block             DailyBlock?     @relation(fields: [blockId], references: [id], onDelete: SetNull)
  checkinAt         DateTime        @default(now())
  energyLevel       Int?
  focusLevel        Int?
  moodLevel         Int?
  brief             String?
  content           Json?           @db.JsonB
  commandText       String?
  parsedCommandJson Json?           @db.JsonB
  applied           Boolean         @default(false)

  @@index([userId])
  @@index([planId])
  @@index([taskOccurrenceId])
  @@index([blockId])
  @@index([userId, checkinAt])
  @@map("checkins")
}

model AutomationRun {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  runType        AutomationRunType
  status         AutomationRunStatus @default(RUNNING)
  triggerSource  String              @default("system") @db.VarChar(64)
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  requestPayload Json?               @db.JsonB
  resultPayload  Json?               @db.JsonB
  errorText      String?

  @@index([userId])
  @@index([userId, runType])
  @@index([userId, startedAt])
  @@index([status])
  @@map("automation_runs")
}

model HomeAssistantConnection {
  userId         String                @id
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseUrl        String                @db.VarChar(500)
  encryptedToken String
  enabled        Boolean               @default(true)
  revision       Int                   @default(1)
  status         String                @default("Waiting for worker") @db.VarChar(240)
  lastSyncedAt   DateTime?
  leaseId        String?               @db.Uuid
  leaseExpiresAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  mappings       HealthEntityMapping[]

  @@map("home_assistant_connections")
}

model HealthEntityMapping {
  userId     String
  connection HomeAssistantConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)
  metric     HealthMetricKind
  entityId   String                  @db.VarChar(240)

  @@id([userId, metric])
  @@unique([userId, entityId])
  @@map("health_entity_mappings")
}

enum HealthMetricKind {
  WEIGHT
  BODY_FAT
  LEAN_MASS
  SLEEP
  TOTAL_CALORIES
  ACTIVE_CALORIES
  STEPS
  BMR
}

model HealthMetric {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric         HealthMetricKind
  value          Decimal          @db.Decimal(20, 6)
  date           DateTime         @db.Date
  observedAt     DateTime
  receivedAt     DateTime         @default(now())
  source         String           @db.VarChar(32)
  entityId       String?          @db.VarChar(240)
  sourceKey      String           @db.VarChar(500)
  timestampBasis String           @db.VarChar(32)
  metadata       Json             @default("{}")

  @@unique([userId, sourceKey])
  @@index([userId, date, metric, observedAt])
  @@map("health_metrics")
}

model HealthGoal {
  metricGoals   Json     @default("{}")
  semantics     Json     @default("{}")
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calorieBalance Int?
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt

  @@map("health_goals")
}


model PlanningProposal {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId      String   @db.Uuid
  requestHash    String   @db.Char(64)
  planDate       DateTime @db.Date
  timezone       String   @db.VarChar(64)
  baseHash       String   @db.Char(64)
  document       Json     @db.JsonB
  preview        Json     @db.JsonB
  status         String   @default("PENDING") @db.VarChar(16)
  receipt        Json?    @db.JsonB
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  @@unique([userId, requestId])
  @@index([userId, planDate, createdAt])
  @@map("planning_proposals")
}

model TaskReview {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String   @db.Uuid
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sourceHash     String   @db.Char(64)
  source         Json     @db.JsonB
  document       Json     @db.JsonB
  promptVersion  String   @db.VarChar(64)
  provider       String   @db.VarChar(64)
  modelId        String   @db.VarChar(200)
  createdAt      DateTime @default(now())
  acceptedAt     DateTime?
  acceptedFields String[] @default([])

  @@index([userId, taskId, createdAt])
  @@map("task_reviews")
}

model TaskIndexJob {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  revision          Int       @default(1)
  completedRevision Int       @default(0)
  attempts          Int       @default(0)
  runAfter          DateTime  @default(now())
  leaseId           String?   @db.Uuid
  leaseExpiresAt    DateTime?
  lastError         String?   @db.VarChar(500)
  // Task triggers insert only userId and rely on this database default.
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([runAfter])
  @@map("task_index_jobs")
}


model PlannerConversation {
  id             String @id @default(uuid()) @db.Uuid
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision       Int @default(0)
  activeTurnId   String? @db.Uuid
  leaseExpiresAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  turns          PlannerConversationTurn[]

  @@index([userId, updatedAt])
  @@map("planner_conversations")
}

model PlannerConversationTurn {
  id             String @id @db.Uuid
  conversationId String @db.Uuid
  conversation   PlannerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  revision       Int
  inputHash      String @db.VarChar(64)
  text           String @db.VarChar(2000)
  status         String @default("GENERATING") @db.VarChar(20)
  result         Json? @db.JsonB
  receipt        Json? @db.JsonB
  createdAt      DateTime @default(now())

  @@unique([conversationId, revision])
  @@map("planner_conversation_turns")
}

model DeviceCredential {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(100)
  clientType String    @db.VarChar(40)
  tokenHash  String    @unique @db.Char(64)
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([userId, createdAt])
  @@map("device_credentials")
}

model DevicePairing {
  id         String    @id @default(uuid()) @db.Uuid
  codeHash   String    @unique @db.Char(64)
  secretHash String    @unique @db.Char(64)
  name       String    @db.VarChar(100)
  clientType String    @db.VarChar(40)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("device_pairings")
}

model DeviceRateLimit {
  key    String   @id
  window DateTime
  count  Int

  @@map("device_rate_limits")
}
