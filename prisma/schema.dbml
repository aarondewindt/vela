////////////////////////////////////////////////////////////
// Physical database schema represented by prisma/schema.prisma.
// Column names and types follow Prisma's PostgreSQL migrations.
////////////////////////////////////////////////////////////

Enum TaskStatus {
	BACKLOG
	PAUSED
	IN_PROGRESS
	DONE
	ARCHIVED
}

Enum DependencyType {
	FINISH_TO_START
	START_TO_START
}

Enum OccurrenceStatus {
	PENDING
	SCHEDULED
	DONE
	SKIPPED
	CANCELED
}

Enum OccurrenceOrigin {
	MANUAL
	RECURRENCE
	IMPORT
}

Enum DailyPlanStatus {
	DRAFT
	ACTIVE
	FINALIZED
	ARCHIVED
}

Enum PlanGenerationSource {
	MANUAL
	MORNING_RUN
	REPLAN
	AUTOMATION
}

Enum BlockStatus {
	PLANNED
	IN_PROGRESS
	DONE
	SKIPPED
	CANCELED
}

Enum BlockSource {
	MANUAL
	PLANNER
	REPLAN
	AUTOMATION
}

Enum DayWorkMode {
	NORMAL
	WFH
	PTO
	NO_WORK
	CUSTOM
}

Enum CalendarEventSource {
	HA
	GOOGLE
	ICS
	MANUAL
}

Enum AutomationRunType {
	PLAN_INIT
	MORNING_RUN
	REPLAN
	CALENDAR_SYNC
	HA_PROJECTION
}

Enum AutomationRunStatus {
	RUNNING
	SUCCESS
	FAILED
	CANCELED
}

Table user {
	id text [pk, not null]
	name text [not null]
	email text [not null]
	emailVerified boolean [not null, default: false]
	image text
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(email) [unique]
	}
}

Table session {
	id text [pk, not null]
	expiresAt timestamp(3) [not null]
	token text [not null]
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]
	ipAddress text
	userAgent text
	userId text [not null]

	Indexes {
		(userId)
		(token) [unique]
	}
}

Table account {
	id text [pk, not null]
	accountId text [not null]
	providerId text [not null]
	userId text [not null]
	accessToken text
	refreshToken text
	idToken text
	accessTokenExpiresAt timestamp(3)
	refreshTokenExpiresAt timestamp(3)
	scope text
	password text
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(userId)
	}
}

Table verification {
	id text [pk, not null]
	identifier text [not null]
	value text [not null]
	expiresAt timestamp(3) [not null]
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(identifier)
	}
}

Table themes {
	id uuid [pk, not null]
	userId text [not null]
	name varchar(120) [not null]
	brief text
	content jsonb [note: 'BlockNote content as JSON array of blocks']
	color varchar(32)
	isActive boolean [not null, default: true]
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(userId)
		(userId, name) [unique]
	}
}

Table locations {
	id uuid [pk, not null]
	userId text [not null]
	name varchar(120) [not null]
	brief text
	content jsonb [note: 'BlockNote content as JSON array of blocks']
	timezone varchar(64)
	latitude decimal(9,6)
	longitude decimal(9,6)
	isActive boolean [not null, default: true]
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(userId)
		(userId, name) [unique]
	}
}

Table tasks {
	id uuid [pk, not null]
	userId text [not null]
	themeId uuid
	locationId uuid
	title varchar(240) [not null]
	brief text
	content jsonb [note: 'BlockNote content as JSON array of blocks']
	priority integer [not null, default: 3, note: '1 (highest) to 5 (lowest)']
	size integer [not null, default: 3, note: '0 Unknown; 1 XL; 2 L; 3 M; 4 S; 5 XS']
	status TaskStatus [not null, default: 'BACKLOG']
	firstStep text
	dueDate date
	earliestStartAt timestamp(3)
	estimatedMinutes integer
	isRecurring boolean [not null, default: false]
	recurrenceRule text
	recurrenceTz varchar(64)
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]
	archivedAt timestamp(3)

	Indexes {
		(userId)
		(userId, status)
		(userId, dueDate)
		(userId, priority)
		(themeId)
		(locationId)
	}
}

Table task_dependencies {
	id uuid [pk, not null]
	userId text [not null]
	blockedTaskId uuid [not null]
	dependsOnTaskId uuid [not null]
	dependencyType DependencyType [not null, default: 'FINISH_TO_START']
	isHardBlock boolean [not null, default: true]
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]

	Indexes {
		(userId)
		(blockedTaskId)
		(dependsOnTaskId)
		(blockedTaskId, dependsOnTaskId) [unique]
	}
}

Table task_occurrences {
	id uuid [pk, not null]
	userId text [not null]
	taskId uuid [not null]
	occurrenceDate date [not null]
	dueAt timestamp(3)
	status OccurrenceStatus [not null, default: 'PENDING']
	origin OccurrenceOrigin [not null, default: 'RECURRENCE']
	generatedRuleVersion integer [not null, default: 1]
	completedAt timestamp(3)
	skippedAt timestamp(3)
	canceledAt timestamp(3)
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(userId)
		(taskId)
		(userId, occurrenceDate)
		(taskId, occurrenceDate) [unique]
		(userId, status)
	}
}

Table daily_plans {
	id uuid [pk, not null]
	userId text [not null]
	planDate date [not null]
	timezone varchar(64) [not null, default: 'UTC']
	status DailyPlanStatus [not null, default: 'DRAFT']
	version integer [not null, default: 1]
	isCurrent boolean [not null, default: true]
	generatedBy PlanGenerationSource [not null, default: 'MANUAL']
	explanationJson jsonb
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]
	finalizedAt timestamp(3)

	Indexes {
		(userId)
		(userId, planDate)
		(userId, planDate, version) [unique]
		(userId, planDate, isCurrent)
	}
}

Table daily_blocks {
	id uuid [pk, not null]
	userId text [not null]
	planId uuid [not null]
	taskOccurrenceId uuid
	title varchar(240) [not null]
	brief text
	content jsonb [note: 'BlockNote content as JSON array of blocks']
	startsAt timestamp(3) [not null]
	endsAt timestamp(3) [not null]
	durationMinutes integer [not null]
	status BlockStatus [not null, default: 'PLANNED']
	source BlockSource [not null, default: 'MANUAL']
	position integer
	isFixed boolean [not null, default: false]
	completedAt timestamp(3)
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(userId)
		(planId)
		(taskOccurrenceId)
		(userId, startsAt)
		(planId, position)
		(planId, startsAt)
	}
}

Table day_overrides {
	id uuid [pk, not null]
	userId text [not null]
	overrideDate date [not null]
	workMode DayWorkMode [not null, default: 'CUSTOM']
	startTime time(6)
	endTime time(6)
	capacityMinutes integer
	locationId uuid
	brief text
	content jsonb [note: 'BlockNote content as JSON array of blocks']
	source varchar(64) [not null, default: 'manual']
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(userId)
		(userId, overrideDate) [unique]
		(locationId)
	}
}

Table calendar_events {
	id uuid [pk, not null]
	userId text [not null]
	externalCalendarId varchar(200) [not null]
	externalEventId varchar(200) [not null]
	title varchar(240) [not null]
	brief text
	content jsonb [note: 'BlockNote content as JSON array of blocks']
	startsAt timestamp(3) [not null]
	endsAt timestamp(3) [not null]
	isAllDay boolean [not null, default: false]
	isBusy boolean [not null, default: true]
	source CalendarEventSource [not null, default: 'MANUAL']
	ownershipMarker varchar(120)
	rawPayload jsonb
	syncedAt timestamp(3)
	createdAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	updatedAt timestamp(3) [not null]

	Indexes {
		(userId)
		(userId, startsAt)
		(userId, endsAt)
		(userId, externalCalendarId, externalEventId) [unique]
	}
}

Table checkins {
	id uuid [pk, not null]
	userId text [not null]
	planId uuid
	taskOccurrenceId uuid
	blockId uuid
	checkinAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	energyLevel integer
	focusLevel integer
	moodLevel integer
	brief text
	content jsonb [note: 'BlockNote content as JSON array of blocks']
	commandText text
	parsedCommandJson jsonb
	applied boolean [not null, default: false]

	Indexes {
		(userId)
		(planId)
		(taskOccurrenceId)
		(blockId)
		(userId, checkinAt)
	}
}

Table automation_runs {
	id uuid [pk, not null]
	userId text [not null]
	runType AutomationRunType [not null]
	status AutomationRunStatus [not null, default: 'RUNNING']
	triggerSource varchar(64) [not null, default: 'system']
	startedAt timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
	finishedAt timestamp(3)
	requestPayload jsonb
	resultPayload jsonb
	errorText text

	Indexes {
		(userId)
		(userId, runType)
		(userId, startedAt)
		(status)
	}
}

Ref: session.userId > user.id [delete: cascade, update: cascade]
Ref: account.userId > user.id [delete: cascade, update: cascade]
Ref: themes.userId > user.id [delete: cascade, update: cascade]
Ref: locations.userId > user.id [delete: cascade, update: cascade]
Ref: tasks.userId > user.id [delete: cascade, update: cascade]
Ref: tasks.themeId > themes.id [delete: set null, update: cascade]
Ref: tasks.locationId > locations.id [delete: set null, update: cascade]
Ref: task_dependencies.userId > user.id [delete: cascade, update: cascade]
Ref: task_dependencies.blockedTaskId > tasks.id [delete: cascade, update: cascade]
Ref: task_dependencies.dependsOnTaskId > tasks.id [delete: cascade, update: cascade]
Ref: task_occurrences.userId > user.id [delete: cascade, update: cascade]
Ref: task_occurrences.taskId > tasks.id [delete: cascade, update: cascade]
Ref: daily_plans.userId > user.id [delete: cascade, update: cascade]
Ref: daily_blocks.userId > user.id [delete: cascade, update: cascade]
Ref: daily_blocks.planId > daily_plans.id [delete: cascade, update: cascade]
Ref: daily_blocks.taskOccurrenceId > task_occurrences.id [delete: set null, update: cascade]
Ref: day_overrides.userId > user.id [delete: cascade, update: cascade]
Ref: day_overrides.locationId > locations.id [delete: set null, update: cascade]
Ref: calendar_events.userId > user.id [delete: cascade, update: cascade]
Ref: checkins.userId > user.id [delete: cascade, update: cascade]
Ref: checkins.planId > daily_plans.id [delete: set null, update: cascade]
Ref: checkins.taskOccurrenceId > task_occurrences.id [delete: set null, update: cascade]
Ref: checkins.blockId > daily_blocks.id [delete: set null, update: cascade]
Ref: automation_runs.userId > user.id [delete: cascade, update: cascade]
